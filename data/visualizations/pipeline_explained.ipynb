   "source": [
    "# Pipeline erklärt — Schritt für Schritt\n",
    "\n",
    "Dieses Notebook zeigt visuell jeden Schritt der Datengenerierung:  \n",
    "Vom Gehirn-Mesh → Graphen → Sichtfeld-Karte → pRF-Signal → GNN-Input."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import torch\n",
    "import matplotlib.pyplot as plt\n",
    "import plotly.graph_objects as go\n",
    "from plotly.subplots import make_subplots\n",
    "from nilearn import datasets, surface\n",
    "\n",
    "# Daten laden\n",
    "ckpt = torch.load('../../data/generated/retinotopy_groundtruth.pt', weights_only=False, map_location='cpu')\n",
    "data = ckpt['data']\n",
    "\n",
    "pos        = data.pos.numpy()               # (17263, 3) — 3D Gehirnkoordinaten\n",
    "ecc        = data.eccentricity_gt.numpy()   # (17263,)   — Exzentrizität in Grad\n",
    "pol        = data.polar_angle_gt.numpy()    # (17263,)   — Polarwinkel in Radiant\n",
    "vf_pos     = data.vf_pos.numpy()            # (17263, 2) — Sichtfeld-Koordinaten\n",
    "responses  = data.x.numpy()                # (17263, 100) — pRF-Antworten\n",
    "edge_index = data.edge_index.numpy()        # (2, 102432)\n",
    "edge_attr  = data.edge_attr.numpy()         # (102432,)\n",
    "\n",
    "print(f\"Knoten: {pos.shape[0]:,}  |  Kanten: {edge_index.shape[1]:,}\")\n",
    "print(f\"Exzentrizität: {ecc.min():.2f}° – {ecc.max():.2f}°\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Schritt 1 — Das Gehirn-Mesh\n",
    "\n",
    "fsaverage ist ein gemitteltes Standard-Gehirn aus hunderten MRT-Scans.  \n",
    "Die Oberfläche besteht aus **163.842 Punkten (Vertices)** und **327.680 Dreiecken**.  \n",
    "Wir nehmen davon nur den **visuellen Kortex** — alles hinter y < −70mm.  \n",
    "Das sind **17.263 Knoten** (~10.5% des Gehirns)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# fsaverage laden um die Dreiecke zu bekommen\n",
    "fsaverage = datasets.fetch_surf_fsaverage('fsaverage')\n",
    "coords_pial, faces_all = surface.load_surf_mesh(fsaverage.pial_left)\n",
    "coords_white, _        = surface.load_surf_mesh(fsaverage.white_left)\n",
    "coords_all = (np.array(coords_pial) + np.array(coords_white)) / 2.0\n",
    "faces_all  = np.array(faces_all)\n",
    "\n",
    "# Visueller Kortex: y < -70mm\n",
    "visual_mask = coords_all[:, 1] < -70.0\n",
    "visual_idx  = np.where(visual_mask)[0]\n",
    "old_to_new  = {old: new for new, old in enumerate(visual_idx)}\n",
    "\n",
    "# Nur Dreiecke die komplett im visuellen Kortex liegen\n",
    "vis_faces = []\n",
    "for tri in faces_all:\n",
    "    if tri[0] in old_to_new and tri[1] in old_to_new and tri[2] in old_to_new:\n",
    "        vis_faces.append([old_to_new[tri[0]], old_to_new[tri[1]], old_to_new[tri[2]]])\n",
    "vis_faces = np.array(vis_faces)\n",
    "\n",
    "# Okzipitalpol (Fovea-Punkt)\n",
    "pole_idx  = int(np.argmin(pos[:, 1]))\n",
    "pole_pos  = pos[pole_idx]\n",
    "\n",
    "print(f\"Dreiecke im visuellen Kortex: {len(vis_faces):,}\")\n",
    "print(f\"Okzipitalpol bei: y={pole_pos[1]:.1f}mm\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig = go.Figure()\n",
    "\n",
    "# Ganzes Gehirn (transparent)\n",
    "fig.add_trace(go.Mesh3d(\n",
    "    x=coords_all[:,0], y=coords_all[:,1], z=coords_all[:,2],\n",
    "    i=faces_all[:,0], j=faces_all[:,1], k=faces_all[:,2],\n",
    "    color='lightgray', opacity=0.12, flatshading=False, name='Ganzes Gehirn',\n",
    "    lighting=dict(ambient=0.6, diffuse=0.8),\n",
    "))\n",
    "\n",
    "# Visueller Kortex (farbig)\n",
    "fig.add_trace(go.Mesh3d(\n",
    "    x=pos[:,0], y=pos[:,1], z=pos[:,2],\n",
    "    i=vis_faces[:,0], j=vis_faces[:,1], k=vis_faces[:,2],\n",
    "    color='steelblue', opacity=0.9, name='Visueller Kortex (17.263 Knoten)',\n",
    "    flatshading=False,\n",
    "    lighting=dict(ambient=0.5, diffuse=0.8, specular=0.3),\n",
    "    lightposition=dict(x=100, y=200, z=150),\n",
    "))\n",
    "\n",
    "# Okzipitalpol\n",
    "fig.add_trace(go.Scatter3d(\n",
    "    x=[pole_pos[0]], y=[pole_pos[1]], z=[pole_pos[2]],\n",
    "    mode='markers', marker=dict(size=8, color='red', symbol='circle'),\n",
    "    name='Okzipitalpol (Fovea)'\n",
    "))\n",
    "\n",
    "fig.update_layout(\n",
    "    title='Schritt 1 — Visueller Kortex (blau) im Gehirn (grau)',\n",
    "    scene=dict(\n",
    "        bgcolor='#111', xaxis_title='x', yaxis_title='y', zaxis_title='z',\n",
    "        camera=dict(eye=dict(x=0.3, y=-2.0, z=0.3))\n",
    "    ),\n",
    "    paper_bgcolor='#111', font_color='white', height=600, legend=dict(font=dict(color='white'))\n",
    ")\n",
    "fig.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Schritt 2 — Geodätische Distanz zum Foveal-Punkt\n",
    "\n",
    "Mit **Dijkstra** berechnen wir für jeden Knoten die kürzeste Distanz  \n",
    "zum Okzipitalpol — gemessen **entlang der Gehirnoberfläche** (nicht durch das Gewebe).  \n",
    "Je röter, desto weiter vom Foveal-Punkt entfernt."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import scipy.sparse as sp\n",
    "from scipy.sparse.csgraph import dijkstra\n",
    "\n",
    "# Graph aufbauen (Euklidische Kantengewichte)\n",
    "u_idx = edge_index[0, :edge_index.shape[1]//2]  # nur eine Richtung\n",
    "v_idx = edge_index[1, :edge_index.shape[1]//2]\n",
    "w     = edge_attr[:edge_index.shape[1]//2]\n",
    "\n",
    "row = np.concatenate([u_idx, v_idx])\n",
    "col = np.concatenate([v_idx, u_idx])\n",
    "dat = np.concatenate([w, w])\n",
    "adj = sp.csr_matrix((dat, (row, col)), shape=(len(pos), len(pos)))\n",
    "\n",
    "geo = dijkstra(adj, directed=False, indices=pole_idx)\n",
    "print(f\"Geodätische Distanz min/max: {geo.min():.1f} / {geo.max():.1f} mm\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig = go.Figure(go.Mesh3d(\n",
    "    x=pos[:,0], y=pos[:,1], z=pos[:,2],\n",
    "    i=vis_faces[:,0], j=vis_faces[:,1], k=vis_faces[:,2],\n",
    "    intensity=geo, colorscale='RdYlBu_r',\n",
    "    colorbar=dict(title='Distanz (mm)', tickfont=dict(color='white'), titlefont=dict(color='white')),\n",
    "    flatshading=False, opacity=1.0,\n",
    "    lighting=dict(ambient=0.5, diffuse=0.8, specular=0.2),\n",
    "    lightposition=dict(x=100, y=200, z=150),\n",
    "))\n",
    "fig.add_trace(go.Scatter3d(\n",
    "    x=[pole_pos[0]], y=[pole_pos[1]], z=[pole_pos[2]],\n",
    "    mode='markers', marker=dict(size=10, color='white', symbol='circle'),\n",
    "    name='Okzipitalpol'\n",
    "))\n",
    "fig.update_layout(\n",
    "    title='Schritt 2 — Geodätische Distanz zum Foveal-Punkt (Dijkstra)',\n",
    "    scene=dict(bgcolor='#111', camera=dict(eye=dict(x=0.3, y=-2.0, z=0.3))),\n",
    "    paper_bgcolor='#111', font_color='white', height=600\n",
    ")\n",
    "fig.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Schritt 3 — Exzentrizität\n",
    "\n",
    "Aus der geodätischen Distanz berechnen wir die **Exzentrizität** in Grad Sehwinkel:  \n",
    "```\n",
    "eccentricity = exp(geo_from_pole / 15.1) - 1.6\n",
    "```\n",
    "Diese Formel kommt aus Schwartz (1980) — die Beziehung zwischen Kortex-Distanz  \n",
    "und visuellem Winkel ist **logarithmisch** (kortikale Magnifikation).  \n",
    "Fovea = viel Kortex pro Grad. Peripherie = wenig Kortex pro Grad."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig = go.Figure(go.Mesh3d(\n",
    "    x=pos[:,0], y=pos[:,1], z=pos[:,2],\n",
    "    i=vis_faces[:,0], j=vis_faces[:,1], k=vis_faces[:,2],\n",
    "    intensity=ecc, colorscale='plasma',\n",
    "    colorbar=dict(title='Exzentrizität (°)', tickfont=dict(color='white'), titlefont=dict(color='white')),\n",
    "    flatshading=False, opacity=1.0,\n",
    "    lighting=dict(ambient=0.5, diffuse=0.8, specular=0.2),\n",
    "    lightposition=dict(x=100, y=200, z=150),\n",
    "))\n",
    "fig.update_layout(\n",
    "    title='Schritt 3 — Exzentrizität (0.1° – 12°)',\n",
    "    scene=dict(bgcolor='#111', camera=dict(eye=dict(x=0.3, y=-2.0, z=0.3))),\n",
    "    paper_bgcolor='#111', font_color='white', height=600\n",
    ")\n",
    "fig.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Schritt 4 — Polarwinkel\n",
    "\n",
    "Der **Polarwinkel** beschreibt die Richtung eines Knotens um den Okzipitalpol herum —  \n",
    "wie ein Kompass. Er wird aus den 3D-Koordinaten im x-z-Gehirnraum berechnet:\n",
    "```\n",
    "polar_angle = arctan2(dz, dx)\n",
    "```\n",
    "Zusammen mit der Exzentrizität ergibt das die vollständige Sichtfeld-Position jedes Knotens."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig = go.Figure(go.Mesh3d(\n",
    "    x=pos[:,0], y=pos[:,1], z=pos[:,2],\n",
    "    i=vis_faces[:,0], j=vis_faces[:,1], k=vis_faces[:,2],\n",
    "    intensity=pol, colorscale='hsv',\n",
    "    colorbar=dict(title='Polarwinkel (rad)', tickfont=dict(color='white'), titlefont=dict(color='white')),\n",
    "    flatshading=False, opacity=1.0,\n",
    "    lighting=dict(ambient=0.5, diffuse=0.8, specular=0.2),\n",
    "    lightposition=dict(x=100, y=200, z=150),\n",
    "))\n",
    "fig.update_layout(\n",
    "    title='Schritt 4 — Polarwinkel (−π bis +π)',\n",
    "    scene=dict(bgcolor='#111', camera=dict(eye=dict(x=0.3, y=-2.0, z=0.3))),\n",
    "    paper_bgcolor='#111', font_color='white', height=600\n",
    ")\n",
    "fig.show()"
   ]
  },
  {
   "cell_type": "markdown",
