    "axes[1].plot(responses[mid_node, :],    alpha=0.8, label=f'Mitte (ecc={ecc[mid_node]:.1f}°)',   color='orange')\n",
    "axes[1].plot(responses[peri_node, :],   alpha=0.8, label=f'Peripher (ecc={ecc[peri_node]:.1f}°)', color='red')\n",
    "axes[1].set_title('Reaktionsprofil von 3 Knoten über alle 100 Stimuli')\n",
    "axes[1].set_xlabel('Stimulus Index'); axes[1].set_ylabel('Reaktionsstärke')\n",
    "axes[1].legend(); axes[1].set_ylim(-0.1, 1.1)\n",
    "\n",
    "fig.suptitle('Schritt 7 — data.x: Das Input-Signal des GNN', fontsize=13)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(f\"data.x Shape: {responses.shape}\")\n",
    "print(f\"Das Netz bekommt {responses.shape[1]} Zahlen pro Knoten und soll 2 Zahlen vorhersagen (ecc, pol).\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Schritt 8 — Kantengewichte: Euklidisch vs. Hyperbolisch\n",
    "\n",
    "Jede Kante zwischen zwei Nachbarknoten hat ein Gewicht — die Distanz in mm.  \n",
    "Wir testen verschiedene Krümmungsparameter **κ**:\n",
    "```\n",
    "d_hyp = (2/√κ) · arcsinh(√κ/2 · d_euc)\n",
    "```\n",
    "**κ=0** → Euklidisch (keine Veränderung)  \n",
    "**κ>0** → große Distanzen werden stärker gestaucht als kleine"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def hyperbolic_weights(distances, kappa):\n",
    "    if kappa == 0.0:\n",
    "        return distances.copy()\n",
    "    sq = np.sqrt(kappa)\n",
    "    return (2.0 / sq) * np.arcsinh((sq / 2.0) * distances)\n",
    "\n",
    "kappas  = [0.0, 0.01, 0.1, 0.5, 1.0]\n",
    "d_range = np.linspace(0, 2, 200)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Links: Transformationskurven\n",
    "colors = plt.cm.plasma(np.linspace(0.1, 0.9, len(kappas)))\n",
    "for kappa, color in zip(kappas, colors):\n",
    "    d_hyp = hyperbolic_weights(d_range, kappa)\n",
    "    axes[0].plot(d_range, d_hyp, label=f'κ={kappa}', color=color)\n",
    "axes[0].plot(d_range, d_range, 'w--', lw=1, alpha=0.4, label='Identität')\n",
    "axes[0].set_xlabel('Euklidische Distanz (mm)'); axes[0].set_ylabel('Transformierte Distanz')\n",
    "axes[0].set_title('Distanztransformation für verschiedene κ')\n",
    "axes[0].legend(); axes[0].grid(alpha=0.2)\n",
    "\n",
    "# Rechts: Histogramm der Kantengewichte\n",
    "for kappa, color in zip(kappas, colors):\n",
    "    w_hyp = hyperbolic_weights(edge_attr[:edge_index.shape[1]//2], kappa)\n",
    "    axes[1].hist(w_hyp, bins=60, alpha=0.5, label=f'κ={kappa}', color=color, density=True)\n",
    "axes[1].set_xlabel('Kantengewicht (mm)'); axes[1].set_ylabel('Dichte')\n",
    "axes[1].set_title('Verteilung der Kantengewichte')\n",
    "axes[1].legend()\n",
    "\n",
    "fig.suptitle('Schritt 8 — Kantengewichte: Euklidisch vs. Hyperbolisch', fontsize=13)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
